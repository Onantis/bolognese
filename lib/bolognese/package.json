{
  "name": "@onantis/bolognese",
  "version": "0.1.1",
  "description": "Syntax validation and automated code resolution for JavaScript and TypeScript.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "bolognese": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "syntax",
    "analyzer",
    "parser",
    "validator",
    "linter",
    "formatter",
    "diagnostics",
    "typescript",
    "javascript",
    "static-analysis",
    "code-quality"
  ],
  "author": "Onantis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Onantis/bolognese.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "typescript": "^5.4.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
